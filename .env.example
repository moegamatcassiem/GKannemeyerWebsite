# Copy this file to .env and fill in real values. .env is gitignored and
# never gets committed — .env.example (this file) is just a template.

# Any random string. Used by Flask to sign session cookies/flash messages.
SECRET_KEY=replace-with-a-long-random-string

# --- Email delivery for the contact form (optional until filled in) ---
# Leave these blank and the contact form keeps working as-is: submissions
# still save to data/submissions.csv, they just won't be emailed anywhere.

# SMTP server details. Defaults below are for Gmail.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# The Gmail address sending the notification email, and its 16-character
# app password (see README for how to generate one).
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# Who the notification email appears to be "From". Usually the same as
# MAIL_USERNAME.
MAIL_DEFAULT_SENDER=your-gmail-address@gmail.com

# Where new contact-form submissions should be sent — the business owner's
# real inbox.
CONTACT_RECIPIENT_EMAIL=owner-inbox@example.com
